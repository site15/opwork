enum OpWorkNotificationType {
  /// Получен новый отклик на вакансию
  APPLICATION_RECEIVED
  /// Кандидат прошел предварительный отбор
  APPLICATION_SHORTLISTED
  /// Назначено интервью
  INTERVIEW_SCHEDULED
  /// Получено предложение о работе
  JOB_OFFER
  /// Подходящая вакансия по критериям поиска
  JOB_MATCH
  /// Обновление статуса вакансии
  JOB_STATUS_CHANGED
  /// Новый проект опубликован
  NEW_PROJECT
  /// Сообщение от другой стороны
  MESSAGE_RECEIVED
  /// Напоминание о действии
  REMINDER
  /// Системное уведомление
  SYSTEM_ALERT
  /// Уведомление о профиле
  PROFILE_UPDATE
  /// Уведомление о сетевых событиях
  NETWORK_ACTIVITY
}

/// Частота отправки уведомлений и оповещений
/// Стандартные интервалы для периодической доставки контента
enum OpWorkFrequency {
  /// Ежеминутно - для срочных уведомлений
  MINUTELY
  /// Ежечасно - для часто обновляемого контента
  HOURLY
  /// Ежедневно - стандартная частота для большинства уведомлений
  DAILY
  /// Еженедельно - для менее срочного контента
  WEEKLY
  /// Ежемесячно - для редких обновлений
  MONTHLY
  /// По требованию - только при наличии новых данных
  ON_DEMAND
}

// ============================================================================
// AUTH MODELS (Система аутентификации и авторизации)
// ============================================================================

/// Основная сущность пользователя системы аутентификации
/// Служит центральной точкой для всех связанных данных пользователя
/// Поддерживает как анонимную, так и внешнюю (Supabase) аутентификацию
model AuthUser {
  /// Уникальный идентификатор пользователя (UUID v4)
  /// Генерируется автоматически при создании записи
  id String @id(map: "PK_AUTH_USER") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  /// Электронная почта пользователя
  /// @IsEmail
  email String?

  /// Хэш пароля пользователя
  password String?

  /// Статус верификации email адреса
  isEmailVerified Boolean?

  /// Анонимный идентификатор пользователя для гостей
  /// Используется до привязки к внешней системе аутентификации
  /// @MaxLength(255)
  anonymousId String?

  /// Идентификатор пользователя в системе Supabase
  /// Уникальный идентификатор из внешней системы аутентификации
  /// @MaxLength(255)
  supabaseUserId String?

  /// Полные данные пользователя, полученные от Supabase
  /// Хранится в формате JSON для максимальной гибкости
  supabaseUserData Json?

  /// Статус активности учетной записи пользователя
  /// Неактивные пользователи не могут выполнять действия в системе
  isActive Boolean?

  /// Временная метка создания учетной записи
  /// Автоматически устанавливается при создании записи
  createdAt DateTime @default(now()) @db.Timestamp(6)

  /// Временная метка последнего обновления данных
  /// Автоматически обновляется при любом изменении записи
  updatedAt DateTime @default(now()) @db.Timestamp(6)

  /// === СВЯЗАННЫЕ ДАННЫЕ ===

  /// Список API-ключей доступа, принадлежащих пользователю
  /// Используются для программного доступа к системе
  AuthApiKey AuthApiKey[]

  /// Все сессии пользователя (активные и завершенные)
  /// История входов и активных подключений
  AuthSession AuthSession[]

  /// Профили пользователя в профессиональной сети
  /// Связь с основной бизнес-системой поиска работы
  OpWorkProfile OpWorkProfile[]

  /// === ОГРАНИЧЕНИЯ И ИНДЕКСЫ ===

  /// Уникальность пользователя по идентификатору Supabase
  /// Гарантирует отсутствие дубликатов внешних учетных записей
  @@unique(name: "uqSupabaseUserId", [supabaseUserId], map: "UQ_AUTH_USER__SUPABASE_USER_ID")
}

/// API-ключ для программного доступа к системе
/// Предоставляет аутентификацию без использования пользовательских сессий
model AuthApiKey {
  /// Уникальный идентификатор API-ключа (UUID v4)
  /// Генерируется автоматически при создании
  id String @id(map: "PK_AUTH_API_KEY") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  /// Идентификатор владельца API-ключа
  /// Ссылка на запись пользователя в системе AuthUser
  userId String @db.Uuid

  /// Значение API-ключа для аутентификации
  /// Хранится в открытом виде для удобства использования
  /// @MaxLength(255)
  apiKey String? @db.VarChar(255)

  /// Статус активности API-ключа
  /// Неактивные ключи блокируются системой
  isActive Boolean?

  /// Временная метка создания ключа
  /// Используется для отслеживания возраста ключа
  createdAt DateTime @default(now()) @db.Timestamp(6)

  /// Временная метка последнего обновления
  /// Фиксирует изменения статуса или других параметров
  updatedAt DateTime @default(now()) @db.Timestamp(6)

  /// === СВЯЗИ ===

  /// Владелец данного API-ключа
  /// Обратная ссылка на учетную запись пользователя
  /// @DtoRelationCanConnectOnCreate
  /// @DtoRelationCanConnectOnUpdate
  AuthUser AuthUser @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_AUTH_API_KEY__USER_ID")

  /// === ОГРАНИЧЕНИЯ И ИНДЕКСЫ ===

  /// Уникальность значения API-ключа
  /// Гарантирует отсутствие дубликатов ключей
  @@unique(name: "uqApiKey", [apiKey], map: "UQ_AUTH_API_KEY__API_KEY")
  /// Индекс для быстрого поиска ключей по пользователю
  /// Оптимизирует запросы по владельцу ключа
  @@index([userId], map: "IDX_AUTH_API_KEY__USER_ID")
}

/// Пользовательская сессия для отслеживания активных подключений
/// Используется для управления текущими входами в систему
model AuthSession {
  /// Уникальный идентификатор сессии (UUID v4)
  /// Генерируется при каждом новом входе пользователя
  id String @id(map: "PK_AUTH_SESSION") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  /// Идентификатор пользователя, которому принадлежит сессия
  /// Ссылка на запись пользователя в системе AuthUser
  userId String @db.Uuid

  /// Статус активности сессии
  /// Активные сессии позволяют пользователю выполнять действия
  isActive Boolean?

  /// Временная метка создания сессии
  /// Фиксирует момент входа пользователя в систему
  createdAt DateTime @default(now()) @db.Timestamp(6)

  /// Временная метка последнего обновления сессии
  /// Используется для отслеживания активности пользователя
  updatedAt DateTime @default(now()) @db.Timestamp(6)

  /// === СВЯЗИ ===

  /// Владелец данной сессии
  /// Обратная ссылка на учетную запись пользователя
  /// @DtoRelationCanConnectOnCreate
  /// @DtoRelationCanConnectOnUpdate
  AuthUser AuthUser @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_AUTH_SESSION__USER_ID")

  /// === ИНДЕКСЫ ===

  /// Индекс для быстрого поиска сессий пользователя
  /// Оптимизирует запросы по активным сессиям конкретного пользователя
  @@index([userId], map: "IDX_AUTH_SESSION__USER_ID")
}

// ============================================================================
// OPWORK BUSINESS MODELS (Основные бизнес-сущности платформы)

  /// Связанный основной профиль
  /// @DtoRelationCanConnectOnCreate
  /// @DtoRelationCanConnectOnUpdate
  OpWorkProfile OpWorkProfile? @relation(fields: [profileId], references: [id], map: "FK_OPWORK_JOB_SEEKER__PROFILE_ID")

  /// Индексы для оптимизации поиска
  @@index([profileId], map: "IDX_OPWORK_JOB_SEEKER__PROFILE_ID")
  @@index([isOpenToWork], map: "IDX_OPWORK_JOB_SEEKER__IS_OPEN_TO_WORK")

/// Статус проекта в жизненном цикле разработки
/// Отражает текущую фазу развития проекта
enum OpWorkProjectStatus {
  /// Идея - концепция на стадии обсуждения
  IDEA
  /// Планирование - разработка технического задания
  PLANNING
  /// Разработка - активная фаза программирования
  DEVELOPMENT
  /// Тестирование - проверка качества и функциональности
  TESTING
  /// Готов к запуску - все готово для выхода в продакшен
  LAUNCH_READY
  /// Живой - проект находится в активной эксплуатации
  LIVE
  /// Поддержка - фаза сопровождения и доработок
  MAINTENANCE
  /// Приостановлен - временно остановлено развитие
  ON_HOLD
  /// Отменен - проект прекращен
  CANCELLED
  /// Завершен - все работы окончены
  COMPLETED
  /// В архиве - проект сохранен для истории
  ARCHIVED
}

/// Тип уведомления в системе

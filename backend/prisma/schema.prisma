model OpWorkJobSeeker {
  /// Уникальный идентификатор профиля соискателя (UUID v4)
  id String @id(map: "PK_OPWORK_JOB_SEEKER") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  /// Связанный основной профиль

  /// @DtoRelationCanConnectOnCreate
  /// @DtoRelationCanConnectOnUpdate
  OpWorkProfile OpWorkProfile @relation(fields: [profileId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_SAVED_JOB__PROFILE_ID")
  /// Сохраненная вакансия
  /// @DtoRelationCanConnectOnCreate
  /// @DtoRelationCanConnectOnUpdate
  OpWorkJob     OpWorkJob     @relation(fields: [jobId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_SAVED_JOB__JOB_ID")

  /// === ОГРАНИЧЕНИЯ И ИНДЕКСЫ ===


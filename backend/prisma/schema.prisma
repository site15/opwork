/// Проект или инициатива пользователя
/// Может представлять стартап, продукт, исследование или любую другую инициативу
model OpWorkProject {
  /// Уникальный идентификатор проекта (UUID v4)
  id String @id(map: "PK_OPWORK_PROJECT") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  /// Связанный основной профиль
  profileId String @db.Uuid

  /// === ОСНОВНАЯ ИНФОРМАЦИЯ ===

  /// Название проекта
  title       String               @db.VarChar(255)
  /// Подробное описание проекта
  description String               @db.Text
  /// Текущий статус проекта в жизненном цикле
  status      OpWorkProjectStatus?
  /// Тип проекта/бизнес-модель
  type        OpWorkProjectType?

  /// === ТЕХНИЧЕСКИЕ ДЕТАЛИ ===

  /// URL репозитория проекта на GitHub
  githubRepoUrl String? @db.VarChar(512)
  /// Используемые технологии и стек
  technologies  String? @db.Text
  /// Архитектурное описание проекта
  architecture  String? @db.Text

  /// === ДАТЫ ПРОЕКТА ===

  /// === ПЛАНИРОВАНИЕ ===
  /// Описание планируемых сроков проекта
  plannedDatesDescription String?   @db.Text
  /// Предполагаемая дата начала проекта (по плану)
  plannedStartDate        DateTime? @db.Timestamp(6)
  /// Предполагаемая дата завершения проекта (по плану)
  plannedEndDate          DateTime? @db.Timestamp(6)

  /// === РЕАЛИЗАЦИЯ ===
  /// Описание этапа реализации проекта
  implementationDescription String?   @db.Text
  /// Фактическая дата начала проекта
  actualStartDate           DateTime? @db.Timestamp(6)
  /// Дата начала фазы активной разработки
  developmentStart          DateTime? @db.Timestamp(6)
  /// Дата начала фазы тестирования
  testingStart              DateTime? @db.Timestamp(6)

  /// === ЗАПУСК ===
  /// Описание этапа запуска продукта
  launchDescription String?   @db.Text
  /// Планируемая дата запуска продукта
  launchDate        DateTime? @db.Timestamp(6)
  /// Фактическая дата выхода продукта в продакшен
  goLiveDate        DateTime? @db.Timestamp(6)

  /// === ЗАВЕРШЕНИЕ ===
  /// Описание завершающего этапа проекта
  completionDescription String?   @db.Text
  /// Фактическая дата завершения всех работ по проекту
  actualEndDate         DateTime? @db.Timestamp(6)
  /// Дата официального завершения проекта (подписание актов и т.д.)
  completionDate        DateTime? @db.Timestamp(6)

  /// === ПОДДЕРЖКА ===
  /// Описание этапа поддержки и сопровождения
  maintenanceDescription String?   @db.Text
  /// Дата начала фазы поддержки и сопровождения
  maintenanceStart       DateTime? @db.Timestamp(6)
  /// Дата окончания фазы поддержки (если планируется)
  maintenanceEnd         DateTime? @db.Timestamp(6)

  /// === СИСТЕМНЫЕ ДАТЫ ===
  /// Временная метка создания записи проекта
  createdAt DateTime @default(now()) @db.Timestamp(6)
  /// Временная метка последнего обновления
  updatedAt DateTime @default(now()) @db.Timestamp(6)

  /// === СВЯЗИ ===

  /// Связанный основной профиль
  OpWorkProfile OpWorkProfile @relation(fields: [profileId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_PROJECT__PROFILE_ID")

  /// === ОГРАНИЧЕНИЯ И ИНДЕКСЫ ===

  /// Уникальность профиля проекта
  /// Гарантирует что у основного профиля может быть только один профиль проекта
  @@unique(name: "uqOpWorkProjectProfile", [profileId], map: "UQ_OPWORK_PROJECT__PROFILE_ID")
  /// Индексы для оптимизации поиска
  @@index([profileId], map: "IDX_OPWORK_PROJECT__PROFILE_ID")
  @@index([title], map: "IDX_OPWORK_PROJECT__TITLE")
}

/// Вакансия/должность для поиска сотрудников
/// Представляет открытую позицию в компании
model OpWorkJob {
  /// Уникальный идентификатор вакансии (UUID v4)
  id         String @id(map: "PK_OPWORK_JOB") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Идентификатор работодателя
  employerId String @db.Uuid
  /// Связанный основной профиль
  profileId  String @db.Uuid

  /// === ОСНОВНАЯ ИНФОРМАЦИЯ ===

  /// Название должности
  title            String @db.VarChar(255)
  /// Подробное описание вакансии
  description      String @db.Text
  /// Требования к кандидату
  requirements     String @db.Text
  /// Обязанности на должности
  responsibilities String @db.Text

  /// === ДЕТАЛИ ВАКАНСИИ ===

  /// Тип занятости
  employmentType  OpWorkEmploymentType
  /// Требуемый уровень опыта
  experienceLevel OpWorkExperienceLevel
  /// Департамент/отдел
  department      String?               @db.VarChar(255)

  /// === ЗАРПЛАТА ===

  /// Минимальный уровень заработной платы
  salaryMin      Int?
  /// Максимальный уровень заработной платы
  salaryMax      Int?
  /// Валюта заработной платы (по умолчанию USD)
  salaryCurrency String? @default("USD") @db.VarChar(3)

  /// === ЛОКАЦИЯ ===

  /// Местоположение работы
  location String?  @db.VarChar(255)
  /// Возможность удаленной работы
  isRemote Boolean? @default(false)

  /// === СТАТУС ===

  /// Текущий статус вакансии
  status OpWorkJobStatus @default(DRAFT)

  /// === СТАТИСТИКА ===

  /// Количество просмотров вакансии
  viewsCount        Int @default(0)
  /// Количество откликов на вакансию
  applicationsCount Int @default(0)
  /// Количество добавлений вакансии в избранное
  savesCount        Int @default(0)

  /// === ДАТЫ ===

  /// Дата публикации вакансии
  publishedAt DateTime? @db.Timestamp(6)
  /// Дата истечения вакансии
  expiresAt   DateTime? @db.Timestamp(6)
  /// Временная метка создания вакансии
  createdAt   DateTime  @default(now()) @db.Timestamp(6)
  /// Временная метка последнего обновления
  updatedAt   DateTime  @default(now()) @db.Timestamp(6)

  /// === СВЯЗИ ===

  /// Работодатель, разместивший вакансию
  OpWorkEmployer    OpWorkEmployer      @relation(fields: [employerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_JOB__EMPLOYER_ID")
  /// Связанный основной профиль
  OpWorkProfile     OpWorkProfile       @relation(fields: [profileId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_JOB__PROFILE_ID")
  /// Все отклики на эту вакансию
  OpWorkApplication OpWorkApplication[]
  /// Требуемые навыки для вакансии
  OpWorkJobSkill    OpWorkJobSkill[]
  /// Сохранения вакансии пользователями
  OpWorkSavedJob    OpWorkSavedJob[]
  /// Просмотры вакансии
  opWorkJobViews    OpWorkJobView[]
  /// Теги вакансии
  opWorkJobTags     OpWorkJobTag[]

  /// === ИНДЕКСЫ ===

  @@index([employerId], map: "IDX_OPWORK_JOB__EMPLOYER_ID")
  @@index([profileId], map: "IDX_OPWORK_JOB__PROFILE_ID")
  @@index([status], map: "IDX_OPWORK_JOB__STATUS")
  @@index([employmentType], map: "IDX_OPWORK_JOB__EMPLOYMENT_TYPE")
  @@index([experienceLevel], map: "IDX_OPWORK_JOB__EXPERIENCE_LEVEL")
  @@index([location], map: "IDX_OPWORK_JOB__LOCATION")
  @@index([isRemote], map: "IDX_OPWORK_JOB__IS_REMOTE")
  @@index([createdAt], map: "IDX_OPWORK_JOB__CREATED_AT")
}

/// Отклик кандидата на вакансию
/// Представляет заявку соискателя на конкретную позицию
model OpWorkApplication {
  /// Уникальный идентификатор отклика (UUID v4)
  id          String @id(map: "PK_OPWORK_APPLICATION") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Идентификатор соискателя
  jobSeekerId String @db.Uuid
  /// Связанный основной профиль
  profileId   String @db.Uuid
  /// Идентификатор вакансии
  jobId       String @db.Uuid

  /// === ДЕТАЛИ ОТКЛИКА ===

  /// Сопроводительное письмо кандидата
  coverLetter  String? @db.Text
  /// URL резюме кандидата
  resumeUrl    String? @db.VarChar(500)
  /// URL портфолио или персонального сайта
  portfolioUrl String? @db.VarChar(500)

  /// === СТАТУС ===

  /// Текущий статус отклика в процессе рассмотрения
  status      OpWorkApplicationStatus @default(PENDING)
  /// Заметки по отклику от HR или рекрутера
  statusNotes String?                 @db.Text

  /// === ДАТЫ ===

  /// Дата подачи отклика
  appliedAt       DateTime  @default(now()) @db.Timestamp(6)
  /// Дата последнего обновления статуса
  statusUpdatedAt DateTime? @db.Timestamp(6)

  /// === СВЯЗИ ===

  /// Соискатель, подавший отклик
  OpWorkJobSeeker OpWorkJobSeeker @relation(fields: [jobSeekerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_APPLICATION__JOB_SEEKER_ID")
  /// Связанный основной профиль
  OpWorkProfile   OpWorkProfile   @relation(fields: [profileId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_APPLICATION__PROFILE_ID")
  /// Вакансия, на которую подан отклик
  OpWorkJob       OpWorkJob       @relation(fields: [jobId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_APPLICATION__JOB_ID")

  /// === ОГРАНИЧЕНИЯ И ИНДЕКСЫ ===

  /// Один соискатель может откликнуться на вакансию только один раз
  @@unique(name: "uqOpWorkJobSeekerJob", [jobSeekerId, jobId], map: "UQ_OPWORK_APPLICATION__JOB_SEEKER_ID_JOB_ID")
  /// Индексы для оптимизации поиска
  @@index([jobSeekerId], map: "IDX_OPWORK_APPLICATION__JOB_SEEKER_ID")
  @@index([profileId], map: "IDX_OPWORK_APPLICATION__PROFILE_ID")
  @@index([jobId], map: "IDX_OPWORK_APPLICATION__JOB_ID")
  @@index([status], map: "IDX_OPWORK_APPLICATION__STATUS")
  @@index([appliedAt], map: "IDX_OPWORK_APPLICATION__APPLIED_AT")
}

/// Сохраненные вакансии пользователя
/// Позволяет пользователям сохранять интересные вакансии для последующего просмотра
model OpWorkSavedJob {
  /// Уникальный идентификатор сохранения (UUID v4)
  id        String   @id(map: "PK_OPWORK_SAVED_JOB") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Идентификатор профиля пользователя
  profileId String   @db.Uuid
  /// Идентификатор сохраненной вакансии
  jobId     String   @db.Uuid
  /// Дата сохранения вакансии
  savedAt   DateTime @default(now()) @db.Timestamp(6)
  /// Персональные заметки пользователя о вакансии
  notes     String?  @db.Text

  /// === СВЯЗИ ===

  /// Профиль пользователя, сохранившего вакансию
  OpWorkProfile OpWorkProfile @relation(fields: [profileId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_SAVED_JOB__PROFILE_ID")
  /// Сохраненная вакансия
  OpWorkJob     OpWorkJob     @relation(fields: [jobId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_SAVED_JOB__JOB_ID")

  /// === ОГРАНИЧЕНИЯ И ИНДЕКСЫ ===

  /// Уникальность сохранения (один профиль - одна вакансия)
  @@unique(name: "uqOpWorkProfileSavedJob", [profileId, jobId], map: "UQ_OPWORK_SAVED_JOB__PROFILE_ID_JOB_ID")
  /// Индексы для оптимизации поиска
  @@index([profileId], map: "IDX_OPWORK_SAVED_JOB__PROFILE_ID")
  @@index([jobId], map: "IDX_OPWORK_SAVED_JOB__JOB_ID")
}

// ============================================================================
// SKILLS & TAGS (Навыки и теги)
// ============================================================================

/// Навык или технология в системе
/// Централизованный справочник всех возможных навыков и технологий
model OpWorkSkill {
  /// Уникальный идентификатор навыка (UUID v4)
  id          String           @id(map: "PK_OPWORK_SKILL") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Название навыка или технологии
  name        String           @db.VarChar(255)
  /// Подробное описание навыка
  description String?          @db.Text
  /// Тип навыка (язык программирования, фреймворк и т.д.)
  type        OpWorkSkillType?
  /// Категория навыка для группировки
  category    String?          @db.VarChar(255)
  /// URL иконки навыка
  icon        String?          @db.VarChar(500)
  /// Популярность навыка (количество использований)
  popularity  Int              @default(0)
  /// Временная метка создания записи
  createdAt   DateTime         @default(now()) @db.Timestamp(6)

  /// === СВЯЗИ ===

  /// Все связи навыка с соискателями
  OpWorkJobSeekerSkill OpWorkJobSeekerSkill[]
  /// Все связи навыка с вакансиями
  OpWorkJobSkill       OpWorkJobSkill[]
  /// Синонимы данного навыка
  opWorkSkillSynonyms  OpWorkSkillSynonym[]

  /// === ОГРАНИЧЕНИЯ И ИНДЕКСЫ ===

  /// Уникальность имени навыка
  @@unique(name: "uqOpWorkSkillName", [name], map: "UQ_OPWORK_SKILL__NAME")
  /// Индексы для оптимизации поиска
  @@index([type], map: "IDX_OPWORK_SKILL__TYPE")
  @@index([category], map: "IDX_OPWORK_SKILL__CATEGORY")
  @@index([popularity], map: "IDX_OPWORK_SKILL__POPULARITY")
}

/// Связь навыка с конкретным соискателем
/// Хранит уровень владения навыком конкретным кандидатом
model OpWorkJobSeekerSkill {
  /// Уникальный идентификатор связи (UUID v4)
  id          String    @id(map: "PK_OPWORK_JOB_SEEKER_SKILL") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Идентификатор соискателя
  jobSeekerId String    @db.Uuid
  /// Идентификатор навыка
  skillId     String    @db.Uuid
  /// Уровень владения навыком (1-5)
  level       Int       @default(3) @db.SmallInt
  /// Количество лет опыта с этим навыком
  yearsOfExp  Int?      @db.SmallInt
  /// Признак основного/ключевого навыка
  isPrimary   Boolean?  @default(false)
  /// Дата последнего использования навыка
  lastUsed    DateTime? @db.Timestamp(6)
  /// Временная метка создания записи
  createdAt   DateTime  @default(now()) @db.Timestamp(6)

  /// === СВЯЗИ ===

  /// Соискатель, владеющий данным навыком
  OpWorkJobSeeker OpWorkJobSeeker @relation(fields: [jobSeekerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_JOB_SEEKER_SKILL__JOB_SEEKER_ID")
  /// Навык
  OpWorkSkill     OpWorkSkill     @relation(fields: [skillId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_JOB_SEEKER_SKILL__SKILL_ID")

  /// === ОГРАНИЧЕНИЯ И ИНДЕКСЫ ===

  /// Уникальность связи (один соискатель - один навык)
  @@unique(name: "uqOpWorkJobSeekerSkill", [jobSeekerId, skillId], map: "UQ_OPWORK_JOB_SEEKER_SKILL__JOB_SEEKER_ID_SKILL_ID")
  /// Индексы для оптимизации поиска
  @@index([jobSeekerId], map: "IDX_OPWORK_JOB_SEEKER_SKILL__JOB_SEEKER_ID")
  @@index([skillId], map: "IDX_OPWORK_JOB_SEEKER_SKILL__SKILL_ID")
  @@index([level], map: "IDX_OPWORK_JOB_SEEKER_SKILL__LEVEL")
}

/// Требования к навыкам для конкретной вакансии
/// Определяет какие навыки необходимы для позиции
model OpWorkJobSkill {
  /// Уникальный идентификатор требования (UUID v4)
  id         String   @id(map: "PK_OPWORK_JOB_SKILL") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Идентификатор вакансии
  jobId      String   @db.Uuid
  /// Идентификатор требуемого навыка
  skillId    String   @db.Uuid
  /// Обязательность навыка для данной позиции
  isRequired Boolean? @default(true)
  /// Важность навыка (1-5)
  importance Int      @default(3) @db.SmallInt
  /// Минимальный требуемый уровень владения
  minLevel   Int?     @db.SmallInt
  /// Временная метка создания записи
  createdAt  DateTime @default(now()) @db.Timestamp(6)

  /// === СВЯЗИ ===

  /// Вакансия, для которой указано требование
  OpWorkJob   OpWorkJob   @relation(fields: [jobId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_JOB_SKILL__JOB_ID")
  /// Требуемый навык
  OpWorkSkill OpWorkSkill @relation(fields: [skillId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_JOB_SKILL__SKILL_ID")

  /// === ОГРАНИЧЕНИЯ И ИНДЕКСЫ ===

  /// Уникальность требования (одна вакансия - один навык)
  @@unique(name: "uqOpWorkJobSkill", [jobId, skillId], map: "UQ_OPWORK_JOB_SKILL__JOB_ID_SKILL_ID")
  /// Индексы для оптимизации поиска
  @@index([jobId], map: "IDX_OPWORK_JOB_SKILL__JOB_ID")
  @@index([skillId], map: "IDX_OPWORK_JOB_SKILL__SKILL_ID")
  @@index([isRequired], map: "IDX_OPWORK_JOB_SKILL__IS_REQUIRED")
}

// ============================================================================
// NOTIFICATIONS & INTERACTIONS (Уведомления и взаимодействия)
// ============================================================================

/// Уведомление пользователя в системе
/// Хранит все уведомления, отправленные пользователям
model OpWorkNotification {
  /// Уникальный идентификатор уведомления (UUID v4)
  id        String  @id(map: "PK_OPWORK_NOTIFICATION") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Идентификатор пользователя-получателя
  userId    String  @db.Uuid
  /// Идентификатор связанного профиля (если применимо)
  profileId String? @db.Uuid

  /// === ДЕТАЛИ УВЕДОМЛЕНИЯ ===

  /// Тип уведомления
  type    OpWorkNotificationType
  /// Заголовок уведомления
  title   String                 @db.VarChar(255)
  /// Текст сообщения уведомления
  message String                 @db.Text
  /// Дополнительные данные в формате JSON
  data    Json?

  /// === СТАТУС ===

  /// Признак прочтения уведомления
  isRead     Boolean? @default(false)
  /// Признак архивирования уведомления
  isArchived Boolean? @default(false)

  /// === ДАТЫ ===

  /// Временная метка создания уведомления
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  /// Временная метка прочтения уведомления
  readAt    DateTime? @db.Timestamp(6)

  /// === СВЯЗИ ===

  /// Пользователь-получатель уведомления
  AuthUser      AuthUser       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_NOTIFICATION__USER_ID")
  /// Связанный профиль (если применимо)
  OpWorkProfile OpWorkProfile? @relation(fields: [profileId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_NOTIFICATION__PROFILE_ID")

  /// === ИНДЕКСЫ ===

  @@index([userId], map: "IDX_OPWORK_NOTIFICATION__USER_ID")
  @@index([profileId], map: "IDX_OPWORK_NOTIFICATION__PROFILE_ID")
  @@index([type], map: "IDX_OPWORK_NOTIFICATION__TYPE")
  @@index([isRead], map: "IDX_OPWORK_NOTIFICATION__IS_READ")
  @@index([createdAt], map: "IDX_OPWORK_NOTIFICATION__CREATED_AT")
}

/// Настройки уведомлений для профиля пользователя
/// Позволяет пользователю настраивать получение уведомлений
model OpWorkNotificationSettings {
  /// Уникальный идентификатор настроек (UUID v4)
  id        String @id(map: "PK_OPWORK_NOTIFICATION_SETTINGS") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Идентификатор профиля
  profileId String @db.Uuid

  /// === ТИПЫ УВЕДОМЛЕНИЙ ===

  /// Email-уведомления об обновлениях откликов
  emailApplicationUpdates Boolean? @default(true)
  /// Email-уведомления о подходящих вакансиях
  emailJobAlerts          Boolean? @default(true)
  /// Email-рассылка новостей
  emailNewsletter         Boolean? @default(false)
  /// Push-уведомления об обновлениях откликов
  pushApplicationUpdates  Boolean? @default(true)
  /// Push-уведомления о подходящих вакансиях
  pushJobAlerts           Boolean? @default(true)

  /// === ЧАСТОТА ===

  /// Частота отправки уведомлений о вакансиях
  jobAlertFrequency OpWorkFrequency? @default(DAILY)

  /// === СИСТЕМНЫЕ ДАТЫ ===

  /// Временная метка последнего обновления настроек
  updatedAt DateTime @default(now()) @db.Timestamp(6)

  /// === СВЯЗИ ===

  /// Профиль, для которого настроены уведомления
  OpWorkProfile OpWorkProfile @relation(fields: [profileId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_NOTIFICATION_SETTINGS__PROFILE_ID")

  /// === ОГРАНИЧЕНИЯ ===

  /// Уникальность настроек (один профиль - одни настройки)
  @@unique(name: "uqOpWorkNotificationSettingsProfile", [profileId], map: "UQ_OPWORK_NOTIFICATION_SETTINGS__PROFILE_ID")
}

// ============================================================================
// SEARCH & ANALYTICS (Поиск и аналитика)
// ============================================================================

/// История поиска вакансий пользователем
/// Хранит все поисковые запросы для анализа поведения пользователей
model OpWorkSearchHistory {
  /// Уникальный идентификатор записи поиска (UUID v4)
  id           String   @id(map: "PK_OPWORK_SEARCH_HISTORY") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Идентификатор профиля пользователя
  profileId    String   @db.Uuid
  /// Текст поискового запроса
  query        String   @db.VarChar(500)
  /// Фильтры поиска в формате JSON
  filters      Json?
  /// Количество найденных результатов
  resultsCount Int?     @default(0)
  /// Временная метка выполнения поиска
  searchedAt   DateTime @default(now()) @db.Timestamp(6)

  /// === СВЯЗИ ===

  /// Профиль пользователя, выполнившего поиск
  OpWorkProfile OpWorkProfile @relation(fields: [profileId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_SEARCH_HISTORY__PROFILE_ID")

  /// === ИНДЕКСЫ ===

  @@index([profileId], map: "IDX_OPWORK_SEARCH_HISTORY__PROFILE_ID")
  @@index([searchedAt], map: "IDX_OPWORK_SEARCH_HISTORY__SEARCHED_AT")
}

/// Просмотры вакансий пользователями
/// Отслеживает популярность вакансий и поведение пользователей
model OpWorkJobView {
  /// Уникальный идентификатор просмотра (UUID v4)
  id        String   @id(map: "PK_OPWORK_JOB_VIEW") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Идентификатор профиля пользователя (если авторизован)
  profileId String?  @db.Uuid
  /// Идентификатор просмотренной вакансии
  jobId     String   @db.Uuid
  /// Временная метка просмотра
  viewedAt  DateTime @default(now()) @db.Timestamp(6)
  /// IP-адрес пользователя
  ipAddress String?  @db.VarChar(45)
  /// User-Agent браузера
  userAgent String?  @db.VarChar(500)

  /// === СВЯЗИ ===

  /// Профиль пользователя (если авторизован)
  OpWorkProfile OpWorkProfile? @relation(fields: [profileId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_JOB_VIEW__PROFILE_ID")
  /// Просмотренная вакансия
  OpWorkJob     OpWorkJob      @relation(fields: [jobId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_JOB_VIEW__JOB_ID")

  /// === ИНДЕКСЫ ===

  @@index([profileId], map: "IDX_OPWORK_JOB_VIEW__PROFILE_ID")
  @@index([jobId], map: "IDX_OPWORK_JOB_VIEW__JOB_ID")
  @@index([viewedAt], map: "IDX_OPWORK_JOB_VIEW__VIEWED_AT")
}

/// Избранные поисковые запросы пользователя
/// Позволяет пользователям сохранять регулярные поисковые запросы
model OpWorkSavedSearch {
  /// Уникальный идентификатор сохраненного поиска (UUID v4)
  id         String           @id(map: "PK_OPWORK_SAVED_SEARCH") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Идентификатор профиля пользователя
  profileId  String           @db.Uuid
  /// Название сохраненного поиска
  name       String           @db.VarChar(255)
  /// Текст поискового запроса
  query      String           @db.VarChar(500)
  /// Фильтры поиска в формате JSON
  filters    Json?
  /// Статус активности сохраненного поиска
  isActive   Boolean?         @default(true)
  /// Частота отправки уведомлений
  frequency  OpWorkFrequency? @default(DAILY)
  /// Дата последней отправки уведомления
  lastSentAt DateTime?        @db.Timestamp(6)
  /// Временная метка создания
  createdAt  DateTime         @default(now()) @db.Timestamp(6)
  /// Временная метка последнего обновления
  updatedAt  DateTime         @default(now()) @db.Timestamp(6)

  /// === СВЯЗИ ===

  /// Профиль пользователя, создавшего сохраненный поиск
  OpWorkProfile OpWorkProfile @relation(fields: [profileId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_SAVED_SEARCH__PROFILE_ID")

  /// === ОГРАНИЧЕНИЯ И ИНДЕКСЫ ===

  /// Уникальность названия для профиля
  @@unique(name: "uqOpWorkSavedSearchProfileName", [profileId, name], map: "UQ_OPWORK_SAVED_SEARCH__PROFILE_ID_NAME")
  /// Индексы для оптимизации поиска
  @@index([profileId], map: "IDX_OPWORK_SAVED_SEARCH__PROFILE_ID")
  @@index([isActive], map: "IDX_OPWORK_SAVED_SEARCH__IS_ACTIVE")
}

// ============================================================================
// ADDITIONAL MODELS (Дополнительные модели)
// ============================================================================

/// Синонимы навыков для улучшения поиска
/// Позволяет находить навыки по альтернативным названиям
model OpWorkSkillSynonym {
  /// Уникальный идентификатор синонима (UUID v4)
  id        String   @id(map: "PK_OPWORK_SKILL_SYNONYM") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Идентификатор основного навыка
  skillId   String   @db.Uuid
  /// Альтернативное название навыка
  synonym   String   @db.VarChar(255)
  /// Временная метка создания записи
  createdAt DateTime @default(now()) @db.Timestamp(6)

  /// === СВЯЗИ ===

  /// Основной навык, для которого указан синоним
  OpWorkSkill OpWorkSkill @relation(fields: [skillId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_SKILL_SYNONYM__SKILL_ID")

  /// === ОГРАНИЧЕНИЯ И ИНДЕКСЫ ===

  /// Уникальность синонима для навыка
  @@unique(name: "uqOpWorkSkillSynonym", [skillId, synonym], map: "UQ_OPWORK_SKILL_SYNONYM__SKILL_ID_SYNONYM")
  /// Индексы для оптимизации поиска
  @@index([skillId], map: "IDX_OPWORK_SKILL_SYNONYM__SKILL_ID")
  @@index([synonym], map: "IDX_OPWORK_SKILL_SYNONYM__SYNONYM")
}

/// Теги для категоризации вакансий
/// Позволяет добавлять произвольные метки к вакансиям
model OpWorkJobTag {
  /// Уникальный идентификатор тега (UUID v4)
  id        String   @id(map: "PK_OPWORK_JOB_TAG") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Идентификатор вакансии
  jobId     String   @db.Uuid
  /// Название тега
  name      String   @db.VarChar(100)
  /// Цвет тега в формате HEX (#RRGGBB)
  color     String?  @db.VarChar(7)
  /// Временная метка создания тега
  createdAt DateTime @default(now()) @db.Timestamp(6)

  /// === СВЯЗИ ===

  /// Вакансия, к которой прикреплен тег
  OpWorkJob OpWorkJob @relation(fields: [jobId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_JOB_TAG__JOB_ID")

  /// === ОГРАНИЧЕНИЯ И ИНДЕКСЫ ===

  /// Уникальность тега для вакансии
  @@unique(name: "uqOpWorkJobTag", [jobId, name], map: "UQ_OPWORK_JOB_TAG__JOB_ID_NAME")
  /// Индексы для оптимизации поиска
  @@index([jobId], map: "IDX_OPWORK_JOB_TAG__JOB_ID")
  @@index([name], map: "IDX_OPWORK_JOB_TAG__NAME")
}

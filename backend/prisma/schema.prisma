// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
}

generator backendClient {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

generator frontendClient {
  provider        = "prisma-client"
  output          = "../../frontend/apps/web-naive/src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

generator prismaClassGenerator {
  prismaClientImportPath          = "../prisma/client"
  provider                        = "ts-node ../prisma-generator-nestjs-dto/src/cli.ts"
  output                          = "../src/generated/rest"
  // frontendOutput                  = "../frontend/src/generated"
  annotateAllDtoProperties        = "true"
  classValidation                 = "true"
  createDtoPrefix                 = "Create"
  definiteAssignmentAssertion     = "true"
  dtoSuffix                       = "Dto"
  entityPrefix                    = ""
  entitySuffix                    = ""
  exportRelationModifierClasses   = "true"
  fileNamingStyle                 = "kebab"
  flatResourceStructure           = "false"
  generateControllers             = "true"
  generateDataProviders           = "false"
  generateForms                   = "false"
  generateLists                   = "false"
  moduleName                      = "metrics"
  noDependencies                  = "false"
  outputToNestJsResourceStructure = "false"
  prettier                        = "true"
  reExport                        = "false"
  updateDtoPrefix                 = "Update"
}

// ============================================================================
// ENUMS
// ============================================================================

/// Тип профиля пользователя в системе поиска работы и рекрутинга
/// Определяет основную роль пользователя в платформе
enum OpWorkUserType {
  /// Соискатель - ищет работу, создает резюме
  JOB_SEEKER
  /// Работодатель - размещает вакансии, ищет сотрудников
  EMPLOYER
  /// Администратор - имеет расширенные права управления системой
  ADMIN
}

/// Статус вакансии в системе рекрутинга
/// Отражает текущее состояние вакансии от черновика до архива
enum OpWorkJobStatus {
  /// Черновик - вакансия создана но не опубликована
  DRAFT
  /// Активна - вакансия опубликована и принимает отклики
  ACTIVE
  /// Приостановлена - временно не принимает отклики
  PAUSED
  /// Закрыта - больше не принимает отклики, но видна в поиске
  CLOSED
  /// В архиве - скрыта из поиска, сохранена для истории
  ARCHIVED
}

/// Тип занятости предлагаемой в вакансии
/// Определяет характер трудовых отношений
enum OpWorkEmploymentType {
  /// Полная занятость - стандартный рабочий день
  FULL_TIME
  /// Частичная занятость - неполный рабочий день
  PART_TIME
  /// Контракт - работа по договору на определенный срок
  CONTRACT
  /// Стажировка - временная практика для получения опыта
  INTERNSHIP
  /// Удаленная работа - полностью удаленный формат
  REMOTE
  /// Фриланс - проектная работа на условиях ИП
  FREELANCE
}

/// Уровень профессионального опыта кандидата
/// Используется для фильтрации вакансий и кандидатов
enum OpWorkExperienceLevel {
  /// Стажировка - начальный уровень без опыта
  INTERNSHIP
  /// Начальный уровень - до 1 года опыта
  ENTRY_LEVEL
  /// Младший специалист - 1-2 года опыта
  JUNIOR
  /// Средний специалист - 2-5 лет опыта
  MIDDLE
  /// Старший специалист - 5-8 лет опыта
  SENIOR
  /// Ведущий специалист - 8-12 лет опыта
  LEAD
  /// Эксперт - более 12 лет опыта
  EXPERT
}

/// Статус отклика на вакансию
/// Отражает текущую стадию рассмотрения кандидата
enum OpWorkApplicationStatus {
  /// Ожидает рассмотрения - новый отклик
  PENDING
  /// Рассмотрен - HR просмотрел резюме
  REVIEWED
  /// В шортлисте - кандидат прошел предварительный отбор
  SHORTLISTED
  /// На интервью - назначен собеседование
  INTERVIEW
  /// Получено предложение - сделано оффер
  OFFER
  /// Отклонен - кандидат не подошел
  REJECTED
  /// Отозван - кандидат сам отозвал отклик
  WITHDRAWN
}

/// Тип профиля в системе поиска работы
/// Определяет основное направление деятельности пользователя
enum OpWorkProfileType {
  /// Проект - профиль для публикации проектов и идей
  PROJECT
  /// Специалист - профиль профессионала для поиска работы
  SPECIALIST
  /// Работодатель - профиль компании или рекрутера
  EMPLOYER
}

/// Тип навыка или технологии
/// Классификация навыков для удобства поиска и фильтрации
enum OpWorkSkillType {
  /// Язык программирования - JavaScript, Python, Java и т.д.
  PROGRAMMING_LANGUAGE
  /// Фреймворк - React, Angular, Django и т.д.
  FRAMEWORK
  /// База данных - PostgreSQL, MongoDB, Redis и т.д.
  DATABASE
  /// Инструмент - Git, Docker, Jenkins и т.д.
  TOOL
  /// Платформа - AWS, Azure, Google Cloud и т.д.
  PLATFORM
  /// Язык (иностранный) - English, German, French и т.д.
  LANGUAGE
  /// Мягкий навык - коммуникация, лидерство, управление временем
  SOFT_SKILL
}

/// Уровень образования кандидата
/// Стандартная классификация образовательных степеней
enum OpWorkEducationDegree {
  /// Средняя школа - базовое общее образование
  HIGH_SCHOOL
  /// Степень младшего специалиста (2 года)
  ASSOCIATE
  /// Бакалавриат - первая высшая степень (3-4 года)
  BACHELOR
  /// Магистратура - вторая высшая степень (1-2 года)
  MASTER
  /// Докторантура - научная степень (3-5 лет)
  DOCTORATE
  /// Сертификат - профессиональная сертификация
  CERTIFICATE
  /// Диплом - профессиональное образование
  DIPLOMA
  /// Послевузовское образование - дополнительные курсы
  POSTGRADUATE
}

/// Академическая успеваемость/оценка
/// Стандартная система оценок с буквенными и числовыми значениями
enum OpWorkGrade {
  /// Отлично+ (высший балл)
  A_PLUS
  /// Отлично
  A
  /// Отлично-
  A_MINUS
  /// Хорошо+
  B_PLUS
  /// Хорошо
  B
  /// Хорошо-
  B_MINUS
  /// Удовлетворительно+
  C_PLUS
  /// Удовлетворительно
  C
  /// Удовлетворительно-
  C_MINUS
  /// Посредственно+
  D_PLUS
  /// Посредственно
  D
  /// Посредственно-
  D_MINUS
  /// Неудовлетворительно
  F
  /// Зачет
  PASS
  /// Незачет
  FAIL
  /// Не завершено
  INCOMPLETE
  /// Прослушивание (без оценки)
  AUDIT
}

/// Тип проекта или бизнес-модели
/// Классификация проектов по их характеру и направлению
enum OpWorkProjectType {
  /// Минимально жизнеспособный продукт - MVP
  MVP
  /// Стартап - новый бизнес с высоким потенциалом роста
  STARTUP
  /// Продукт - законченное программное решение
  PRODUCT
  /// Услуга - оказание профессиональных услуг
  SERVICE
  /// Консалтинг - предоставление экспертных знаний
  CONSULTING
  /// Агентство - компания предоставляющая услуги третьим лицам
  AGENCY
  /// SaaS - программное обеспечение как услуга
  SAAS
  /// Электронная коммерция - онлайн торговля
  ECOMMERCE
  /// Мобильное приложение - приложение для смартфонов
  MOBILE_APP
  /// Веб-приложение - браузерное приложение
  WEB_APP
  /// Корпоративное решение - для крупных организаций
  ENTERPRISE
  /// Некоммерческая организация - благотворительность, НКО
  NON_PROFIT
  /// Образовательный проект - обучение, курсы
  EDUCATION
  /// Медицинский проект - здравоохранение, медицина
  HEALTHCARE
  /// Финтех - финансовые технологии
  FINTECH
  /// Игровой проект - видеоигры, гейминг
  GAMING
  /// Искусственный интеллект и машинное обучение
  AI_ML
  /// Блокчейн и криптовалюты
  BLOCKCHAIN
  /// Интернет вещей - IoT решения
  IOT
  /// Маркетинг и реклама
  MARKETING
}

/// Статус проекта в жизненном цикле разработки
/// Отражает текущую фазу развития проекта
enum OpWorkProjectStatus {
  /// Идея - концепция на стадии обсуждения
  IDEA
  /// Планирование - разработка технического задания
  PLANNING
  /// Разработка - активная фаза программирования
  DEVELOPMENT
  /// Тестирование - проверка качества и функциональности
  TESTING
  /// Готов к запуску - все готово для выхода в продакшен
  LAUNCH_READY
  /// Живой - проект находится в активной эксплуатации
  LIVE
  /// Поддержка - фаза сопровождения и доработок
  MAINTENANCE
  /// Приостановлен - временно остановлено развитие
  ON_HOLD
  /// Отменен - проект прекращен
  CANCELLED
  /// Завершен - все работы окончены
  COMPLETED
  /// В архиве - проект сохранен для истории
  ARCHIVED
}

/// Тип уведомления в системе
/// Классификация уведомлений по их содержанию и назначению
enum OpWorkNotificationType {
  /// Получен новый отклик на вакансию
  APPLICATION_RECEIVED
  /// Кандидат прошел предварительный отбор
  APPLICATION_SHORTLISTED
  /// Назначено интервью
  INTERVIEW_SCHEDULED
  /// Получено предложение о работе
  JOB_OFFER
  /// Подходящая вакансия по критериям поиска
  JOB_MATCH
  /// Обновление статуса вакансии
  JOB_STATUS_CHANGED
  /// Новый проект опубликован
  NEW_PROJECT
  /// Сообщение от другой стороны
  MESSAGE_RECEIVED
  /// Напоминание о действии
  REMINDER
  /// Системное уведомление
  SYSTEM_ALERT
  /// Уведомление о профиле
  PROFILE_UPDATE
  /// Уведомление о сетевых событиях
  NETWORK_ACTIVITY
}

/// Частота отправки уведомлений и оповещений
/// Стандартные интервалы для периодической доставки контента
enum OpWorkFrequency {
  /// Ежеминутно - для срочных уведомлений
  MINUTELY
  /// Ежечасно - для часто обновляемого контента
  HOURLY
  /// Ежедневно - стандартная частота для большинства уведомлений
  DAILY
  /// Еженедельно - для менее срочного контента
  WEEKLY
  /// Ежемесячно - для редких обновлений
  MONTHLY
  /// По требованию - только при наличии новых данных
  ON_DEMAND
}

// ============================================================================
// AUTH MODELS (Система аутентификации и авторизации)
// ============================================================================

/// Основная сущность пользователя системы аутентификации
/// Служит центральной точкой для всех связанных данных пользователя
/// Поддерживает как анонимную, так и внешнюю (Supabase) аутентификацию
model AuthUser {
  /// Уникальный идентификатор пользователя (UUID v4)
  /// Генерируется автоматически при создании записи
  id String @id(map: "PK_AUTH_USER") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  /// Анонимный идентификатор пользователя для гостей
  /// Используется до привязки к внешней системе аутентификации
  anonymousId String?

  /// Идентификатор пользователя в системе Supabase
  /// Уникальный идентификатор из внешней системы аутентификации
  supabaseUserId String?

  /// Полные данные пользователя, полученные от Supabase
  /// Хранится в формате JSON для максимальной гибкости
  supabaseUserData Json?

  /// Статус активности учетной записи пользователя
  /// Неактивные пользователи не могут выполнять действия в системе
  isActive Boolean?

  /// Временная метка создания учетной записи
  /// Автоматически устанавливается при создании записи
  createdAt DateTime @default(now()) @db.Timestamp(6)

  /// Временная метка последнего обновления данных
  /// Автоматически обновляется при любом изменении записи
  updatedAt DateTime @default(now()) @db.Timestamp(6)

  /// === СВЯЗАННЫЕ ДАННЫЕ ===

  /// Список API-ключей доступа, принадлежащих пользователю
  /// Используются для программного доступа к системе
  AuthApiKey AuthApiKey[]

  /// Все сессии пользователя (активные и завершенные)
  /// История входов и активных подключений
  AuthSession AuthSession[]

  /// Профили пользователя в профессиональной сети
  /// Связь с основной бизнес-системой поиска работы
  OpWorkProfile       OpWorkProfile[]
  opWorkNotifications OpWorkNotification[]

  /// === ОГРАНИЧЕНИЯ И ИНДЕКСЫ ===

  /// Уникальность пользователя по идентификатору Supabase
  /// Гарантирует отсутствие дубликатов внешних учетных записей
  @@unique(name: "uqSupabaseUserId", [supabaseUserId], map: "UQ_AUTH_USER__SUPABASE_USER_ID")
}

/// API-ключ для программного доступа к системе
/// Предоставляет аутентификацию без использования пользовательских сессий
model AuthApiKey {
  /// Уникальный идентификатор API-ключа (UUID v4)
  /// Генерируется автоматически при создании
  id String @id(map: "PK_AUTH_API_KEY") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  /// Идентификатор владельца API-ключа
  /// Ссылка на запись пользователя в системе AuthUser
  userId String @db.Uuid

  /// Значение API-ключа для аутентификации
  /// Хранится в открытом виде для удобства использования
  apiKey String? @db.VarChar(255)

  /// Статус активности API-ключа
  /// Неактивные ключи блокируются системой
  isActive Boolean?

  /// Временная метка создания ключа
  /// Используется для отслеживания возраста ключа
  createdAt DateTime @default(now()) @db.Timestamp(6)

  /// Временная метка последнего обновления
  /// Фиксирует изменения статуса или других параметров
  updatedAt DateTime @default(now()) @db.Timestamp(6)

  /// === СВЯЗИ ===

  /// Владелец данного API-ключа
  /// Обратная ссылка на учетную запись пользователя
  AuthUser AuthUser @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_AUTH_API_KEY__USER_ID")

  /// === ОГРАНИЧЕНИЯ И ИНДЕКСЫ ===

  /// Уникальность значения API-ключа
  /// Гарантирует отсутствие дубликатов ключей
  @@unique(name: "uqApiKey", [apiKey], map: "UQ_AUTH_API_KEY__API_KEY")
  /// Индекс для быстрого поиска ключей по пользователю
  /// Оптимизирует запросы по владельцу ключа
  @@index([userId], map: "IDX_AUTH_API_KEY__USER_ID")
}

/// Пользовательская сессия для отслеживания активных подключений
/// Используется для управления текущими входами в систему
model AuthSession {
  /// Уникальный идентификатор сессии (UUID v4)
  /// Генерируется при каждом новом входе пользователя
  id String @id(map: "PK_AUTH_SESSION") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  /// Идентификатор пользователя, которому принадлежит сессия
  /// Ссылка на запись пользователя в системе AuthUser
  userId String @db.Uuid

  /// Статус активности сессии
  /// Активные сессии позволяют пользователю выполнять действия
  isActive Boolean?

  /// Временная метка создания сессии
  /// Фиксирует момент входа пользователя в систему
  createdAt DateTime @default(now()) @db.Timestamp(6)

  /// Временная метка последнего обновления сессии
  /// Используется для отслеживания активности пользователя
  updatedAt DateTime @default(now()) @db.Timestamp(6)

  /// === СВЯЗИ ===

  /// Владелец данной сессии
  /// Обратная ссылка на учетную запись пользователя
  AuthUser AuthUser @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_AUTH_SESSION__USER_ID")

  /// === ИНДЕКСЫ ===

  /// Индекс для быстрого поиска сессий пользователя
  /// Оптимизирует запросы по активным сессиям конкретного пользователя
  @@index([userId], map: "IDX_AUTH_SESSION__USER_ID")
}

// ============================================================================
// OPWORK BUSINESS MODELS (Основные бизнес-сущности платформы)
// ============================================================================

/// Основной профиль пользователя в профессиональной сети
/// Служит центральной точкой для всех профессиональных данных пользователя
model OpWorkProfile {
  /// Уникальный идентификатор профиля (UUID v4)
  /// Генерируется автоматически при создании
  id String @id(map: "PK_OPWORK_PROFILE") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid

  /// Идентификатор владельца профиля
  /// Ссылка на учетную запись пользователя в системе аутентификации
  userId String @db.Uuid

  /// Тип профиля в системе
  /// Определяет основное назначение профиля (проект/специалист/работодатель)
  type OpWorkProfileType

  /// Тип пользователя в контексте рекрутинга
  /// Определяет роль пользователя (соискатель/работодатель/админ)
  userType OpWorkUserType

  /// === ОСНОВНАЯ ИНФОРМАЦИЯ ===

  /// Заголовок профиля (имя, название компании, название проекта)
  title           String?  @db.VarChar(255)
  /// Подробное описание профиля
  description     String?  @db.Text
  /// Статус активности профиля
  isActive        Boolean? @default(true)
  /// Статус верификации email адреса
  isEmailVerified Boolean? @default(false)

  /// === КОНТАКТНАЯ ИНФОРМАЦИЯ ===

  /// Электронная почта для профессиональных контактов
  email    String? @db.VarChar(255)
  /// Номер телефона
  phone    String? @db.VarChar(50)
  /// Персональный или корпоративный сайт
  website  String? @db.VarChar(500)
  /// Географическое расположение
  location String? @db.VarChar(255)

  /// === МЕДИА ===

  /// URL аватара пользователя/логотипа компании
  avatarUrl  String? @db.VarChar(500)
  /// URL обложки профиля
  coverImage String? @db.VarChar(500)

  /// === СИСТЕМНЫЕ ДАТЫ ===

  /// Временная метка создания профиля
  createdAt DateTime @default(now()) @db.Timestamp(6)
  /// Временная метка последнего обновления
  updatedAt DateTime @default(now()) @db.Timestamp(6)

  /// === СВЯЗИ ===

  /// Владелец профиля в системе аутентификации
  AuthUser                   AuthUser                    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_PROFILE__USER_ID")
  /// Профиль соискателя (если применимо)
  opWorkJobSeeker            OpWorkJobSeeker?
  /// Профиль работодателя (если применимо)
  opWorkEmployer             OpWorkEmployer?
  /// Профиль проекта (если применимо)
  opWorkProject              OpWorkProject?
  /// Размещенные вакансии
  opWorkJobs                 OpWorkJob[]
  /// Отклики на вакансии
  opWorkApplications         OpWorkApplication[]
  /// Сохраненные вакансии
  opWorkSavedJobs            OpWorkSavedJob[]
  /// Уведомления пользователя
  opWorkNotifications        OpWorkNotification[]
  /// Настройки уведомлений
  opWorkNotificationSettings OpWorkNotificationSettings?
  /// История поиска
  opWorkSearchHistories      OpWorkSearchHistory[]

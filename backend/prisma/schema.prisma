  /// @DtoRelationCanConnectOnUpdate
  OpWorkJobSeeker OpWorkJobSeeker @relation(fields: [jobSeekerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_OPWORK_EXPERIENCE__JOB_SEEKER_ID")

